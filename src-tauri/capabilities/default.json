{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：通知 / 对话框 / 打开链接都经 sidecar 校验后由 Rust 执行，webview 只保留通知插件注入脚本启动时的只读权限查询",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-toggle-maximize", "notification:allow-is-permission-granted"]
}
