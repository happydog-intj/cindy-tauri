{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cindy Tauri",
  "version": "0.0.1",
  "identifier": "com.cindy.tauri.p1",
  "build": {
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/cindy-node"
    ],
    "resources": {
      "../sidecar/dist/sidecar.cjs": "sidecar/sidecar.cjs",
      "../sidecar/dist/headless/": "sidecar/headless/",
      "../sidecar/dist/native/": "sidecar/native/"
    }
  }
}
