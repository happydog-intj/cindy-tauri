{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cindy Tauri",
  "version": "0.0.1",
  "identifier": "com.cindy.tauri",
  "build": {
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/cindy-node"
    ],
    "resources": {
      "../sidecar/dist/sidecar.cjs": "sidecar/sidecar.cjs",
      "../sidecar/dist/headless/": "sidecar/headless/",
      "../sidecar/dist/native/": "sidecar/native/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBOUZDODI5RkRCOTcyNDEKUldSQmNybjlLY2lmR2srdUo0NXM5SDBuVHltSVJlZFdVWGxwMGQ5L3JwazlMaTlrcDlOS0o4RCsK",
      "endpoints": [
        "https://github.com/happydog-intj/cindy-tauri/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
