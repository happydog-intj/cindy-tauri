{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cindy Tauri",
  "version": "0.0.1",
  "identifier": "com.cindy.tauri.p1",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Cindy Tauri P1", "width": 1100, "height": 760 }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/cindy-node"],
    "resources": {
      "../sidecar/dist/sidecar.cjs": "sidecar/sidecar.cjs",
      "../sidecar/dist/headless/": "sidecar/headless/"
    }
  }
}
